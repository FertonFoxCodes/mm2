        if not (math.abs(hrpPos.X) < 10000 and math.abs(hrpPos.Y) < 10000 and math.abs(hrpPos.Z) < 10000) then
            Tab:Notification({
                Title = "Fling Error",
                Text = "You must be on the map to use fling!",
                Time = 3,
            })
            return
        end

        local targetPlayer = game.Players:FindFirstChild(SelectedUser)
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local targetChar = targetPlayer.Character
            local targetHRP = targetChar.HumanoidRootPart

            -- Try to freeze their movement, if possible
            local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
            local oldWalkSpeed, oldJumpPower
            if targetHumanoid then
                oldWalkSpeed = targetHumanoid.WalkSpeed
                oldJumpPower = targetHumanoid.JumpPower
                -- Set WalkSpeed and JumpPower to 0 to "freeze"
                targetHumanoid.WalkSpeed = 0
                targetHumanoid.JumpPower = 0
            end

            -- Classic "fling" method using extreme angular velocity
            -- Create a FlingPart if it doesn't exist
            if not character:FindFirstChild("FlingPart") then
                local flingPart = Instance.new("Part")
                flingPart.Name = "FlingPart"
                flingPart.Size = Vector3.new(3,3,1)
                flingPart.Transparency = 1
                flingPart.CanCollide = false
                flingPart.Anchored = false
                flingPart.Massless = true
                flingPart.Parent = character
                local weld = Instance.new("WeldConstraint")
                weld.Part0 = humanoidRootPart
                weld.Part1 = flingPart
                weld.Parent = flingPart
                flingPart.Position = humanoidRootPart.Position
            end

            local flingPart = character:FindFirstChild("FlingPart")
            if not flingPart then return end

            local startCFrame = humanoidRootPart.CFrame

            -- Bring your character, and fling part, directly on top of target repeatedly, forcibly
            for i = 1,30 do
                humanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(math.random(-1,1), 0, math.random(-1,1))
                flingPart.CFrame = targetHRP.CFrame

                -- Classic roblox "fling" spin
                flingPart.RotVelocity = Vector3.new(
                    math.random(-50,50)*100, 
                    math.random(-50,50)*100, 
                    math.random(-50,50)*100
                )
                -- Sudden velocity burst into their body
                flingPart.Velocity = (targetHRP.Position - humanoidRootPart.Position).Unit * 500 + Vector3.new(0,200,0)

                -- Additionally, "push" the humanoidrootpart of the target downwards for a moment
                if targetHRP and targetHRP:IsA("BasePart") then
                    targetHRP.Velocity = Vector3.new(0,-250,0)
                end

                task.wait(1/30)
            end

            -- Restore WalkSpeed and JumpPower after attempted fling
            if targetHumanoid and oldWalkSpeed and oldJumpPower then
                task.delay(0.5, function()
                    targetHumanoid.WalkSpeed = oldWalkSpeed
                    targetHumanoid.JumpPower = oldJumpPower
                end)
            end

            -- Cleanup: Remove velocities and restore position
            humanoidRootPart.CFrame = startCFrame
            flingPart.CFrame = startCFrame
            flingPart.Velocity = Vector3.new(0,0,0)
            flingPart.RotVelocity = Vector3.new(0,0,0)
        end
    end,
})

-- Notifications utility
local function notify(title, text, duration)
    if game:GetService("StarterGui") and game.StarterGui.SetCore then
        pcall(function()
            game.StarterGui:SetCore("SendNotification", {
                Title = title or "Notification",
                Text = text or "",
                Duration = duration or 3
            })
        end)
    end
end

local autoShootEnabled = false
local autoShootConnection

local function autoShootMurder()
    -- Assumes the presence of a Weapon or Tool in the Character named "Gun" or similar
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local gun = character:FindFirstChildOfClass("Tool")
    if not gun then
        notify("AutoShoot", "No gun found!")
        return
    end

    notify("AutoShoot", "Auto shooter enabled")

    autoShootEnabled = true

    autoShootConnection = game:GetService("RunService").RenderStepped:Connect(function()
        if not autoShootEnabled then
            if autoShootConnection then
                autoShootConnection:Disconnect()
                autoShootConnection = nil
            end
            return
        end

        -- Look for a suspected murderer (simple heuristic: anyone with a knife/tool named "Knife")
        for _, otherPlayer in ipairs(game.Players:GetPlayers()) do
            if otherPlayer ~= player and otherPlayer.Character then
                local knife = otherPlayer.Character:FindFirstChild("Knife") or otherPlayer.Character:FindFirstChildWhichIsA("Tool")
                if knife and knife.Name == "Knife" then
                    notify("AutoShoot", "Murderer detected: " .. tostring(otherPlayer.Name))
                    local targetHRP = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        -- Aim gun at murderer and shoot (simulate click or FireServer)
                        -- Camera aim
                        workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, targetHRP.Position)
                        -- Try to fire (you may need to adjust this for your game's gun API)
                        if gun:FindFirstChild("Shoot") and gun.Shoot:IsA("RemoteEvent") then
                            gun.Shoot:FireServer(targetHRP.Position)
                        elseif gun:FindFirstChild("Remote") then
                            gun.Remote:FireServer(targetHRP.Position)
                        elseif gun:FindFirstChild("Activate") then
                            gun:Activate()
                        end
                        break
                    end
                end
            end
        end
    end)
end

local function stopAutoShootMurder()
    autoShootEnabled = false
    notify("AutoShoot", "Auto shooter disabled")
end

-- Add a button to the UI for toggling auto shoot
Tab:Button({
    Title = "Auto Shoot Murderer",
    Desc = "Automatically shoot the murderer if detected",
    Callback = function()
        if not autoShootEnabled then
            autoShootMurder()
        else
            stopAutoShootMurder()
        end
    end,
})

