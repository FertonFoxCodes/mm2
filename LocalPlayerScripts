-- Coin collection handler
CoinCollected.OnClientEvent:Connect(function(coin_type, current, max)
	if coin_type == ToFarm then
		total_collected += 1
		if current == max then
			bag_full = true
			tween_to(start_position, 2).Completed:Wait()
			-- Only apply kill all (murderer) if enabled.
			if murderer_auto_kill_enabled and isMurderer() then
				killAllPlayers()
				task.wait(2)
				bag_full = false
				return
			end
			-- Otherwise, just "die" to reset (like normal farm)
			if Character:FindFirstChild("Humanoid") then
				Character.Humanoid.Health = 0
			end
			task.wait(5)
			bag_full = false
		end
	end
end)

