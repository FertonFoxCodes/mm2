-- Enhanced ESP Tool (Draws role overlay boxes with names and always shows their role, fitting the whole body)

local espEnabled = false
local espConnections = {}
local espDrawings = {} -- Track per-character

local function removeEsp()
    for _, drawing in pairs(espDrawings) do
        if typeof(drawing) == "table" then
            if drawing.box then drawing.box:Remove() end
            if drawing.name then drawing.name:Remove() end
        end
    end
    espDrawings = {}

    for _, conn in ipairs(espConnections) do
        if conn.Disconnect then conn:Disconnect() end
    end
    espConnections = {}
end

-- Helper to determine role: "Murderer", "Sheriff", or "Innocent"
local function getPlayerRole(player, character)
    if not character then return "Unknown" end

    -- Check Backpack and Character for items
    local function hasItem(where, name)
        return where:FindFirstChild(name)
    end
    -- Check for "Knife"
    if hasItem(character, "Knife") or hasItem(player.Backpack, "Knife") then
        return "Murderer"
    end
    -- Check for "Gun"
    if hasItem(character, "Gun") or hasItem(player.Backpack, "Gun") then
        return "Sheriff"
    end
    return "Innocent"
end

local function colorForRole(role)
    if role == "Murderer" then
        return Color3.fromRGB(255, 36, 36) -- red
    elseif role == "Sheriff" then
        return Color3.fromRGB(50, 150, 255) -- blue
    elseif role == "Innocent" then
        return Color3.fromRGB(0, 255, 90) -- green
    else
        return Color3.new(1,1,1) -- fallback
    end
end

-- Get world AABB for character via key parts. Handles ragdoll, limbs, etc.
local function getBoundingBox(character)
    local parts = {}
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 and part.Size.Magnitude > 0.25 then
            table.insert(parts, part)
        end
    end
    if #parts == 0 then return nil end

    local minVec = parts[1].Position
    local maxVec = parts[1].Position
    for _, part in ipairs(parts) do
        local size = part.Size/2
        local cmin = part.Position - size
        local cmax = part.Position + size
        minVec = Vector3.new(
            math.min(minVec.X, cmin.X),
            math.min(minVec.Y, cmin.Y),
            math.min(minVec.Z, cmin.Z)
        )
        maxVec = Vector3.new(
            math.max(maxVec.X, cmax.X),
            math.max(maxVec.Y, cmax.Y),
            math.max(maxVec.Z, cmax.Z)
        )
    end
    return minVec, maxVec
end

local function createDrawingBox(name, color)
    local Drawing = Drawing or Drawing -- workaround for studio/injector context
    -- Use BillboardGui if Drawing API is not available
    if Drawing then
        local box = Drawing.new("Square")
        box.Thickness = 2
        box.Filled = false
        box.Color = color
        box.Visible = true

        local text = Drawing.new("Text")
        text.Size = 16
        text.Center = true
        text.Outline = true
        text.Font = 2
        text.Text = name
        text.Color = color
        text.Visible = true

        return {box = box, name = text}
    else
        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0,120,0,35)
        billboard.AlwaysOnTop = true
        billboard.Name = "ESPBillboard"

        local textLabel = Instance.new("TextLabel", billboard)
        textLabel.BackgroundTransparency = 1
        textLabel.TextStrokeTransparency = 0
        textLabel.Size = UDim2.new(1,0,1,0)
        textLabel.TextScaled = true
        textLabel.Text = name
        textLabel.TextColor3 = color
        textLabel.Font = Enum.Font.SourceSansBold

        billboard.Parent = game:GetService("CoreGui")

        return {billboard = billboard, label = textLabel}
    end
end

local function updateESP()
    local camera = workspace.CurrentCamera

    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= game.Players.LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local character = player.Character
            local role = getPlayerRole(player, character)
            local roleColor = colorForRole(role)

            if not espDrawings[player] then
                espDrawings[player] = createDrawingBox(player.Name .. " ["..role.."]", roleColor)
            end

            -- Drawing API
            if espDrawings[player].box then
                local minVec, maxVec = getBoundingBox(character)
                if minVec and maxVec then
                    -- Find 8 corners of the box, project to screen, take min/max 2D
                    local corners = {
                        Vector3.new(minVec.X, minVec.Y, minVec.Z),
                        Vector3.new(minVec.X, minVec.Y, maxVec.Z),
                        Vector3.new(minVec.X, maxVec.Y, minVec.Z),
                        Vector3.new(minVec.X, maxVec.Y, maxVec.Z),
                        Vector3.new(maxVec.X, minVec.Y, minVec.Z),
                        Vector3.new(maxVec.X, minVec.Y, maxVec.Z),
                        Vector3.new(maxVec.X, maxVec.Y, minVec.Z),
                        Vector3.new(maxVec.X, maxVec.Y, maxVec.Z),
                    }
                    local minX, minY = math.huge, math.huge
                    local maxX, maxY = -math.huge, -math.huge
                    local onScreenCount = 0
                    for _, corner in ipairs(corners) do
                        local screenPos, visible = camera:WorldToViewportPoint(corner)
                        if visible then
                            onScreenCount = onScreenCount + 1
                            minX = math.min(minX, screenPos.X)
                            minY = math.min(minY, screenPos.Y)
                            maxX = math.max(maxX, screenPos.X)
                            maxY = math.max(maxY, screenPos.Y)
                        end
                    end

                    local boxVisible = onScreenCount >= 2 -- at least 2 corners visible
                    espDrawings[player].box.Visible = boxVisible
                    espDrawings[player].name.Visible = boxVisible
                    espDrawings[player].box.Color = roleColor
                    espDrawings[player].name.Color = roleColor
                    espDrawings[player].name.Text = player.Name.." ["..role.."]"

                    if boxVisible then
                        local w, h = (maxX-minX), (maxY-minY)
                        espDrawings[player].box.Position = Vector2.new(minX, minY)
                        espDrawings[player].box.Size = Vector2.new(w, h)
                        espDrawings[player].name.Position = Vector2.new(minX+w/2, minY-18)
                    end
                else
                    espDrawings[player].box.Visible = false
                    espDrawings[player].name.Visible = false
                end
            else
                -- Billboard fallback
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if hrp and espDrawings[player].billboard then
                    espDrawings[player].billboard.Adornee = hrp
                    espDrawings[player].billboard.ExtentsOffset = Vector3.new(0,3,0)
                    if espDrawings[player].label then
                        espDrawings[player].label.Text = player.Name.." ["..role.."]"
                        espDrawings[player].label.TextColor3 = roleColor
                    end
                end
            end
        elseif espDrawings[player] then
            -- Cleanup on player death/leave
            if espDrawings[player].box then espDrawings[player].box:Remove() end
            if espDrawings[player].name then espDrawings[player].name:Remove() end
            if espDrawings[player].billboard then espDrawings[player].billboard:Destroy() end
            espDrawings[player] = nil
        end
    end
end

local function toggleEsp(state)
    espEnabled = state
    if state then
        notify("ESP", "ESP Enabled")
        -- Update ESP frequently (use Heartbeat/RenderStepped for lowest latency)
        table.insert(espConnections, game:GetService("RunService").RenderStepped:Connect(updateESP))
    else
        notify("ESP", "ESP Disabled")
        removeEsp()
    end
end

